# AI Monitoring Nutrition Assistant - Root Environment Reference
#
# Frontend environment variables (.env in client/ or Vercel dashboard):
# VITE_API_BASE_URL=https://<your-backend>.onrender.com
#
# Backend environment variables (.env in server/ or Render dashboard):
# MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# DATABASE_NAME=nutrition_assistant
# JWT_SECRET=your_jwt_secret_key_change_in_production
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
# CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MAX_TOKENS=1024
